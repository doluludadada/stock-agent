# Keys read by the settings classes in backend/src/b_application/config/. A blank value counts as "not configured".

# AI providers. Only the key for ai.active_model in config/appsetting.yaml is required: currently claude, which reads
# ANTHROPIC_API_KEY. Without it the CLI and the Web API stop right after startup.
ANTHROPIC_API_KEY=""
GROK_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
# NVIDIA's hosted models, for ai.active_model nvidia.
NVIDIA_API_KEY=""

# Optional web search for the AI adapters.
TAVILY_API_KEY=""

# LINE bot (FastAPI webhook in backend/main.py only; the CLI does not use these).
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# User accounts. The app makes the key that encrypts the saved usernames and emails itself: the first start creates
# secrets/accounts.key (gitignored). Back up secrets/ with the database; without the same key no one can sign in again.
# ACCOUNTS_KEY (32 random bytes, base64url) overrides the file, and environment: prod requires it. A blank value counts
# as unset. In Docker Compose the file lives in STATE_DIR, which outlives the containers.
# ACCOUNTS_KEY=""

# Sign-in with Google (optional). The OAuth client of the site, from Google Cloud Console: a client of the type "Web
# application" whose authorized redirect URI is <accounts.public_origin>/v1/auth/google/callback. The site offers
# sign-in with Google when both are set and accounts.public_origin is set in config/appsetting.yaml: all three, or
# none, or the app refuses to start. docs/web-integration.md has the steps. A blank value counts as unset.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Shioaji (SinoPac), read only as config/appsetting.yaml's environment allows. Dev and test log in to Shioaji's
# paper-trading server with this key pair: dev for realtime quotes only (its broker stays the mock), test also trades
# there. Without the pair, a personal site starts with no realtime quotes.
SHIOAJI_API_KEY_TEST=""
# The secret key of the paper-trading pair above.
SHIOAJI_SECRET_KEY_TEST=""
# Prod only: the real account. Dev and test refuse to start while any of these five is set, so keep them only in the
# production machine's .env. SHIOAJI_CA_PATH points at the CA certificate, kept at secrets/Sinopac.pfx (gitignored).
# SHIOAJI_API_KEY=""
# SHIOAJI_SECRET_KEY=""
# SHIOAJI_CA_PATH="secrets/Sinopac.pfx"
# SHIOAJI_CA_PASSWORD=""
# SHIOAJI_PERSON_ID=""

# PostgreSQL. db.backend in config/appsetting.yaml chooses the database, never these keys. db.backend: postgresql
# needs DB_USER, DB_PASSWORD, DB_HOST and DB_NAME. db.backend: sqlite keeps the local file stock_agent.db, and refuses
# to start while all four are set. In Docker Compose, set DB_USER, DB_PASSWORD and DB_NAME: the postgres service is
# created with them, and compose.yml sets DB_HOST and DB_PORT itself. Make the password with `openssl rand -hex 24`,
# and never change it after the first start: the database keeps the one it was created with.
# DB_USER="stock_agent"
# DB_PASSWORD=""
# DB_HOST=""
# DB_PORT="5432"
# DB_NAME="stock_agent"

# Docker Compose only (compose.yml). frontend/docs/deployment.md has the steps.
# The host folder that keeps everything the site saves: config/, secrets/, backups/, .settings-admin/, chroma_data/ and
# the PostgreSQL data in postgres/. Create it with mode 700, owned by the user below. Required.
# STATE_DIR="/srv/stock-agent-state"
# The user and the group that own STATE_DIR on the host. The backend runs as them. `id -u` and `id -g` print yours.
# APP_UID="1000"
# APP_GID="1000"
# Where the proxy listens on the host, over plain http. The loopback address, the default, is for `tailscale serve`
# in front of it, which adds HTTPS. The Tailscale address of the server serves the tailnet directly, without HTTPS.
# Never 0.0.0.0 or a LAN address: every device on that network could then reach the site.
# PROXY_BIND="127.0.0.1"
# PROXY_PORT="8080"
# The host name the browser uses: the name of the server in the tailnet. The proxy answers no other name, and
# api.allowed_hosts in the config/appsetting.yaml of STATE_DIR must list it too.
# SITE_NAME="my-server.my-tailnet.ts.net"
