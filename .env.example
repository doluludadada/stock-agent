# Keys read by backend/src/b_application/schemas/config.py. A blank value counts as "not configured".

# AI providers. Only the key for ai.active_model in config/appsetting.yaml (currently grok) is required;
# without it the CLI exits right after startup.
GROK_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Optional web search for the AI adapters.
TAVILY_API_KEY=""

# LINE bot (FastAPI webhook in backend/main.py only; the CLI does not use these).
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# PostgreSQL. Leave commented to use the local SQLite file stock_agent.db.
# Setting DB_USER, DB_PASSWORD, DB_HOST and DB_NAME together switches to PostgreSQL.
# DB_USER=""
# DB_PASSWORD=""
# DB_HOST=""
# DB_PORT="5432"
# DB_NAME=""
