# Keys read by the settings classes in backend/src/b_application/config/. A blank value counts as "not configured".

# AI providers. Only the key for ai.active_model in config/appsetting.yaml is required: currently claude, which reads
# ANTHROPIC_API_KEY. Without it the CLI and the Web API stop right after startup.
ANTHROPIC_API_KEY=""
GROK_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
# NVIDIA's hosted models, for ai.active_model nvidia.
NVIDIA_API_KEY=""

# Optional web search for the AI adapters.
TAVILY_API_KEY=""

# LINE bot (FastAPI webhook in backend/main.py only; the CLI does not use these).
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# User accounts. The app makes the key that encrypts the saved usernames and emails itself: the first start creates
# secrets/accounts.key (gitignored). Back up secrets/ with the database; without the same key no one can sign in again.
# ACCOUNTS_KEY (32 random bytes, base64url) overrides the file, for Docker or production. A blank value counts as unset.
# ACCOUNTS_KEY=""

# Shioaji (SinoPac), read only as config/appsetting.yaml's environment allows. Dev reads none.
# Test (staging) logs in to Shioaji's paper-trading server with this key pair only.
SHIOAJI_API_KEY_TEST=""
# The secret key of the paper-trading pair above.
SHIOAJI_SECRET_KEY_TEST=""
# Prod only: the real account. Dev and test refuse to start while any of these five is set, so keep them only in the
# production machine's .env. SHIOAJI_CA_PATH points at the CA certificate, kept at secrets/Sinopac.pfx (gitignored).
# SHIOAJI_API_KEY=""
# SHIOAJI_SECRET_KEY=""
# SHIOAJI_CA_PATH="secrets/Sinopac.pfx"
# SHIOAJI_CA_PASSWORD=""
# SHIOAJI_PERSON_ID=""

# PostgreSQL. db.backend in config/appsetting.yaml chooses the database, never these keys. db.backend: postgresql
# needs DB_USER, DB_PASSWORD, DB_HOST and DB_NAME. db.backend: sqlite keeps the local file stock_agent.db, and refuses
# to start while all four are set.
# DB_USER=""
# DB_PASSWORD=""
# DB_HOST=""
# DB_PORT="5432"
# DB_NAME=""
